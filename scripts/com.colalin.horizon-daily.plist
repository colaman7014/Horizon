<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.colalin.horizon-daily</string>
    <key>ProgramArguments</key>
    <array>
        <!-- caffeinate keeps the Mac fully awake for the daily run after the
             00:57 pmset scheduled wake (sudo pmset repeat wakeorpoweron
             MTWRFSU 00:57:00); it releases the assertions when done. -->
        <string>/usr/bin/caffeinate</string>
        <string>-d</string>
        <string>-i</string>
        <string>-m</string>
        <string>-s</string>
        <string>-u</string>
        <string>/bin/bash</string>
        <string>/Users/colalin/repos/Horizon/scripts/daily-run-local.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>1</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/colalin/Library/Logs/horizon-daily.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/colalin/Library/Logs/horizon-daily.log</string>
</dict>
</plist>
